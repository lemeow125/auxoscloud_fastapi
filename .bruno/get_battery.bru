meta {
  name: Get Battery
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/api/battery
  body: json
  auth: inherit
}

tests {
  const response = res.getBody();
  const status = res.getStatus();

  test("Status code is 200", function () {
    expect(status).to.equal(200);
  });

  test("Response has data object", function () {
    expect(response).to.have.property("data");
  });

  test("batterySoc exists", function () {
    expect(response.data).to.have.property("batterySoc");
  });

  test("batterySoh exists", function () {
    expect(response.data).to.have.property("batterySoh");
  });

  test("batteryPower exists", function () {
    expect(response.data).to.have.property("batteryPower");
  });
}