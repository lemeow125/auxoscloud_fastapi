meta {
  name: Get Analytics
  type: http
  seq: 2
}

get {
  url: {{BASE_URL}}/api/analytics
  body: json
  auth: inherit
}

tests {
  const response = res.getBody();
  const status = res.getStatus();

  test("Status code is 200", function () {
    expect(status).to.equal(200);
  });

  test("Response has data object", function () {
    expect(response).to.have.property("data");
  });

  test("energyData.power exists", function () {
    expect(response.data.energyData).to.have.property("power");
  });

  test("energyData.yt exists", function () {
    expect(response.data.energyData).to.have.property("yt");
  });

}